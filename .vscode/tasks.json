{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run GUI",
      "type": "process",
      "command": "${workspaceFolder}/../msys64-ct/usr/bin/bash.exe",
      "args": ["--login", "-c", "./scripts/run_gui.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CHERE_INVOKING": "1", "MSYSTEM": "MSYS" }
      },
      "group": {
        "kind": "build",
      }
    },
    {
      "label": "Build GUI (no run)",
      "type": "process",
      "command": "${workspaceFolder}/../msys64-ct/usr/bin/bash.exe",
      "args": ["--login", "-c", "./scripts/run_gui.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CHERE_INVOKING": "1", "MSYSTEM": "MSYS", "RUN": "0" }
      },
      "group": "build"
    },
    {
      "label": "Debug GUI (gdb build)",
      "type": "process",
      "command": "${workspaceFolder}/../msys64-ct/usr/bin/bash.exe",
      "args": ["--login", "-c", "./scripts/run_gui.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CHERE_INVOKING": "1", "MSYSTEM": "MSYS", "DBG": "1", "RUN": "0" }
      },
      "group": "build"
    },
    {
      "label": "Rebuild GUI deps (imgui/implot/glfw/freetype)",
      "type": "process",
      "command": "${workspaceFolder}/../msys64-ct/usr/bin/bash.exe",
      "args": ["--login", "-c", "./scripts/run_gui.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CHERE_INVOKING": "1", "MSYSTEM": "MSYS", "DEPS": "1", "RUN": "0" }
      },
      "group": "build"
    }
  ]
}