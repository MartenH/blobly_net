diff --git a/window_api.v b/window_api.v
index f8cf6af..86f050b 100644
--- a/window_api.v
+++ b/window_api.v
@@ -553,3 +553,11 @@ pub fn (window &Window) window_size() (int, int) {
 pub fn (window &Window) window_rect() gg.Rect {
 	return gg.Rect{0, 0, window.window_size.width, window.window_size.height}
 }
+
+// resize sets the window size in logical units at runtime (macOS/Windows/X11;
+// no-op on Wayland). gg already implements the per-platform resize; this just
+// surfaces it on Window so apps can resize without reaching into the private
+// gg.Context.
+pub fn (mut window Window) resize(width int, height int) {
+	window.ui.resize(width, height)
+}
