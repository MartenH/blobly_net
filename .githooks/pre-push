#!/usr/bin/env bash
# The other half of the seatbelt (see pre-commit): git runs no commit hook for a rebase or a
# cherry-pick, so a replayed commit under a work identity would reach the remote unseen. This
# re-checks the author and committer of every commit about to be pushed — git's own fields,
# nothing parsed out of prose. Enable with:  git config core.hooksPath .githooks
#
# SCOPE. This guards against a MISCONFIGURED laptop, not against a hostile local user: anyone
# with a shell in this checkout can skip any hook with --no-verify. So it is built to be
# correct for the honest case and cheap, not to resist evasion. A contributor who shares the
# surname trips it too — the heuristic's price; --no-verify is the override for that known case.
set -euo pipefail

# $2 is the destination LOCATION, which is not $1 when a remote has a separate pushurl.
dest="${2:-${1:-origin}}"
zero='0000000000000000000000000000000000000000'
have=()   # what the destination holds RIGHT NOW — asked once, on first need (one round trip)
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue                      # branch deletion
	if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		# New branch, or an old tip never fetched here. No LOCAL baseline is trustworthy for
		# that (a tracking ref can be stale after a server-side delete), and no baseline at all
		# rescans history the destination already holds — which, with contributors free to use
		# any identity, is not durably clean (codex #327 r8, r9). So the baseline is the
		# destination's current refs: exactly the commits this push does not introduce.
		if [ ${#have[@]} -eq 0 ]; then
			while read -r sha _ref; do
				git cat-file -e "$sha^{commit}" 2>/dev/null && have+=("^$sha")
			done < <(git ls-remote "$dest" 2>/dev/null || true)   # every advertised ref, custom namespaces included
		fi
		range=("$local_sha" "${have[@]}")                        # unreachable remote: scan everything
	else
		range=("$remote_sha..$local_sha")
	fi
	# --no-replace-objects: judge the objects that will be sent, not a local replacement.
	# One line per identity, "Name <address>"; a name cannot contain a newline.
	idents=$(git --no-replace-objects log --format='%an <%ae>%n%cn <%ce>' "${range[@]}") \
		|| { echo "pre-push: cannot list the commits to check; refusing to push unchecked." >&2; exit 1; }
	bad=$(printf '%s\n' "$idents" | grep -i hildell | grep -vi '<marten\.hildell@gmail\.com>$' || true)
	if [ -n "$bad" ]; then
		echo "pre-push: a commit about to be pushed looks like the maintainer under the wrong address:" >&2
		printf '%s\n' "$bad" | sed 's/<[^>]*>/<…>/' | sort -u >&2   # only the name: the address is the thing not to print
		echo "            fix the identity (git rebase -i / git commit --amend) and retry." >&2
		exit 1
	fi
done
