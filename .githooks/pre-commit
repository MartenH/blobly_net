#!/usr/bin/env bash
# Refuse a commit whose author is not allowed (see allowed_author in _email_scan.sh) — the
# same rule CI enforces (.github/workflows/guard.yml), checked here so it fails in one second
# instead of after a push. Enable with:  git config core.hooksPath .githooks
set -euo pipefail

. "$(dirname "$0")/_email_scan.sh"

# Ask git for the EFFECTIVE author, not `git config user.email`. They differ exactly when it
# matters: `git commit --author=…`, GIT_AUTHOR_EMAIL in the environment, and cherry-picks or
# rebases that preserve someone else's authorship all keep a correct-looking config while
# producing a commit the CI guard will reject. `git var GIT_AUTHOR_IDENT` resolves the same
# identity the commit will carry.
#   format: "Name <email> 1690000000 +0200"  ->  take the <…> field
author="$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')"

if ! allowed_author "$author"; then
	echo "pre-commit: refusing to commit authored by '$(redact "${author:-<unset>}")'." >&2
	explain_identity
	echo "  (also check GIT_AUTHOR_EMAIL and any --author= flag)" >&2
	exit 1
fi
