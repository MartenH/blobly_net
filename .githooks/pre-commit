#!/usr/bin/env bash
# The maintainer's seatbelt, opt-in and local: refuse a commit from the maintainer under any
# address but the personal one. A work address once reached this history and had to be
# rewritten out of every commit; this is what keeps a work-laptop git config from doing it
# again. It is not CI and not policy — contributors commit under whatever they like.
# Enable on your own machine with:  git config core.hooksPath .githooks
set -euo pipefail

# Ask git for the EFFECTIVE author (config, GIT_AUTHOR_EMAIL, --author=, a replayed commit).
ident="$(git var GIT_AUTHOR_IDENT)"
email="$(printf '%s' "$ident" | sed -n 's/.*<\(.*\)>.*/\1/p')"

case "${ident,,}" in
	*hildell*)
		[ "${email,,}" = "marten.hildell@gmail.com" ] || {
			echo "pre-commit: this looks like the maintainer under the wrong address." >&2
			echo "            git config user.email marten.hildell@gmail.com" >&2
			exit 1
		} ;;
esac
