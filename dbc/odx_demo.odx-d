<?xml version="1.0" encoding="UTF-8"?>
<!-- A hand-made ODX 2.2 description for blobly/odx's tests: one BodyController base variant with
     a DID of each layout the reader holds (text, a structure of integers, a signed integer,
     bytes), one it does not (a LINEAR scaling), a service of another kind, and an ECU variant
     that inherits all of it but a NOT-INHERITED service and adds a DID and a DTC. -->
<ODX xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" MODEL-VERSION="2.2.0">
  <DIAG-LAYER-CONTAINER ID="DLC_BodyController">
    <SHORT-NAME>DLC_BodyController</SHORT-NAME>
    <BASE-VARIANTS>
      <BASE-VARIANT ID="BV_BodyController">
        <SHORT-NAME>BodyController_Base</SHORT-NAME>
        <LONG-NAME>Body controller</LONG-NAME>
        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="DOP_DTC_Base">
              <SHORT-NAME>DOP_DTC_Base</SHORT-NAME>
              <DIAG-CODED-TYPE xsi:type="STANDARD-LENGTH-TYPE" BASE-DATA-TYPE="A_UINT32">
                <BIT-LENGTH>24</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32" />
              <COMPU-METHOD>
                <CATEGORY>IDENTICAL</CATEGORY>
              </COMPU-METHOD>
              <DTCS>
                <DTC ID="DTC_LampOpen">
                  <SHORT-NAME>LampOpenCircuit</SHORT-NAME>
                  <TROUBLE-CODE>9511681</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>B1123-01</DISPLAY-TROUBLE-CODE>
                  <TEXT>Lamp open circuit</TEXT>
                </DTC>
                <DTC ID="DTC_LowVoltage">
                  <SHORT-NAME>SupplyLow</SHORT-NAME>
                  <TROUBLE-CODE>13697046</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U1100-16</DISPLAY-TROUBLE-CODE>
                  <TEXT>Supply voltage low</TEXT>
                </DTC>
              </DTCS>
            </DTC-DOP>
          </DTC-DOPS>
          <DATA-OBJECT-PROPS>
            <DATA-OBJECT-PROP ID="DOP_UINT8">
              <SHORT-NAME>UInt8</SHORT-NAME>
              <COMPU-METHOD>
                <CATEGORY>IDENTICAL</CATEGORY>
              </COMPU-METHOD>
              <DIAG-CODED-TYPE xsi:type="STANDARD-LENGTH-TYPE" BASE-DATA-TYPE="A_UINT32">
                <BIT-LENGTH>8</BIT-LENGTH>
              </DIAG-CODED-TYPE>
