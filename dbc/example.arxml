<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  example.arxml - a hand-written AUTOSAR 4.2 system description exercising everything
  modules/candb/arxml.v reads (one feature per frame, so a failing test names the feature):

    Powertrain 0x100   cyclic 100 ms, ECU_A -> ECU_B, ECU_C; Intel + Motorola + signed + enum
    LampFrame  0x200   E2E profile 1 (data id 0x2A, CRC byte 6, counter byte 7), mixed timing
    SecureFrame 0x300  SecOC (data id 0x2B, 3-byte payload, 8-bit freshness at byte 3, 32-bit MAC at 4..7)
    Wide       0x1ABCDE extended id, CAN-FD, event-driven
    DiagReq    0x7E0   an N-PDU (ISO-TP): a real frame with no signals

  Who sends and who listens is said BOTH ways a system description can: FRAME-PORTs on the
  triggerings and the ECUs' associated I-PDU groups. Physical scaling sits on the SYSTEM-SIGNAL
  (the standard's home for it); Torque additionally carries a UNIT-REF on its I-SIGNAL.

  cantools reads it too (sut/arxml_oracle.py) - that is what keeps this a real AUTOSAR file
  and not one that only our reader accepts.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>

    <AR-PACKAGE>
      <SHORT-NAME>Cluster</SHORT-NAME>
      <ELEMENTS>
        <CAN-CLUSTER>
          <SHORT-NAME>Body</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <BAUDRATE>500000</BAUDRATE>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>Channel</SHORT-NAME>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_Powertrain</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_A/Conn/Powertrain_Out</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_B/Conn/Powertrain_In</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_C/Conn/Powertrain_In</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Frames/Powertrain</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Cluster/Body/Channel/PT_Powertrain</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <CAN-FRAME-RX-BEHAVIOR>CAN-20</CAN-FRAME-RX-BEHAVIOR>
                      <CAN-FRAME-TX-BEHAVIOR>CAN-20</CAN-FRAME-TX-BEHAVIOR>
                      <IDENTIFIER>256</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_LampFrame</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_B/Conn/LampFrame_Out</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_A/Conn/LampFrame_In</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Frames/LampFrame</FRAME-REF>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>0x200</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_SecureFrame</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_B/Conn/SecureFrame_Out</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_A/Conn/SecureFrame_In</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Frames/SecureFrame</FRAME-REF>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>768</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_Wide</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_C/Conn/Wide_Out</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Frames/Wide</FRAME-REF>
                      <CAN-ADDRESSING-MODE>EXTENDED</CAN-ADDRESSING-MODE>
                      <CAN-FRAME-RX-BEHAVIOR>CAN-FD</CAN-FRAME-RX-BEHAVIOR>
                      <CAN-FRAME-TX-BEHAVIOR>CAN-FD</CAN-FRAME-TX-BEHAVIOR>
                      <IDENTIFIER>1752286</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FT_DiagReq</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/ECUs/ECU_A/Conn/DiagReq_In</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Frames/DiagReq</FRAME-REF>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>2016</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_Powertrain</SHORT-NAME>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDUs/Powertrain_PDU</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_Secure_Payload</SHORT-NAME>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDUs/SecurePayload_PDU</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
              <CAN-FD-BAUDRATE>2000000</CAN-FD-BAUDRATE>
            </CAN-CLUSTER-CONDITIONAL>
          </CAN-CLUSTER-VARIANTS>
        </CAN-CLUSTER>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>Frames</SHORT-NAME>
      <ELEMENTS>
        <CAN-FRAME>
          <SHORT-NAME>Powertrain</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>Powertrain_Map</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDUs/Powertrain_PDU</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>LampFrame</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>LampFrame_Map</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDUs/LampFrame_PDU</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>SecureFrame</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>SecureFrame_Map</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="SECURED-I-PDU">/PDUs/Secure_PDU</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>Wide</SHORT-NAME>
          <FRAME-LENGTH>16</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>Wide_Map</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/PDUs/Wide_PDU</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DiagReq</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DiagReq_Map</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/PDUs/DiagReq_NPDU</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>PDUs</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>Powertrain_PDU</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <MINIMUM-DELAY>0.02</MINIMUM-DELAY>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.1</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>EngineSpeed_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/EngineSpeed</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>CoolantTemp_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/CoolantTemp</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>16</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Gear_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/Gear</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>24</START-POSITION>
              <TRANSFER-PROPERTY>TRIGGERED</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Torque_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/Torque</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <START-POSITION>39</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
          <UNUSED-BIT-PATTERN>0</UNUSED-BIT-PATTERN>
        </I-SIGNAL-I-PDU>

        <I-SIGNAL-I-PDU>
          <SHORT-NAME>LampFrame_PDU</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <MINIMUM-DELAY>0.01</MINIMUM-DELAY>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>1.0E-1</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                  <EVENT-CONTROLLED-TIMING>
                    <NUMBER-OF-REPETITIONS>0</NUMBER-OF-REPETITIONS>
                  </EVENT-CONTROLLED-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>LampOn_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/LampOn</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>TRIGGERED</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>LampCrc_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/LampCrc</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>48</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>LampCounter_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/LampCounter</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>56</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>

        <SECURED-I-PDU>
          <SHORT-NAME>Secure_PDU</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <PAYLOAD-REF DEST="PDU-TRIGGERING">/Cluster/Body/Channel/PT_Secure_Payload</PAYLOAD-REF>
          <SECURE-COMMUNICATION-PROPS>
            <AUTH-INFO-TX-LENGTH>32</AUTH-INFO-TX-LENGTH>
            <DATA-ID>43</DATA-ID>
            <FRESHNESS-VALUE-ID>1</FRESHNESS-VALUE-ID>
            <FRESHNESS-VALUE-LENGTH>64</FRESHNESS-VALUE-LENGTH>
            <FRESHNESS-VALUE-TX-LENGTH>8</FRESHNESS-VALUE-TX-LENGTH>
          </SECURE-COMMUNICATION-PROPS>
          <USE-AS-CRYPTOGRAPHIC-I-PDU>false</USE-AS-CRYPTOGRAPHIC-I-PDU>
        </SECURED-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>SecurePayload_PDU</SHORT-NAME>
          <LENGTH>3</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.05</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Rpm_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/Rpm</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>

        <I-SIGNAL-I-PDU>
          <SHORT-NAME>Wide_PDU</SHORT-NAME>
          <LENGTH>16</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <EVENT-CONTROLLED-TIMING>
                    <NUMBER-OF-REPETITIONS>0</NUMBER-OF-REPETITIONS>
                  </EVENT-CONTROLLED-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Odometer_Map</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/Odometer</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>64</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>

        <N-PDU>
          <SHORT-NAME>DiagReq_NPDU</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </N-PDU>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>Signals</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL>
          <SHORT-NAME>EngineSpeed</SHORT-NAME>
          <DATA-TYPE-POLICY>LEGACY</DATA-TYPE-POLICY>
          <LENGTH>16</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/EngineSpeed</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>CoolantTemp</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/sint8</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/CoolantTemp</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>Gear</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint8</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/Gear</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>Torque</SHORT-NAME>
          <LENGTH>12</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint16</BASE-TYPE-REF>
                <UNIT-REF DEST="UNIT">/Units/Nm</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/Torque</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>LampOn</SHORT-NAME>
          <LENGTH>1</LENGTH>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/LampOn</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>LampCrc</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/LampCrc</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>LampCounter</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/LampCounter</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>Rpm</SHORT-NAME>
          <LENGTH>16</LENGTH>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/Rpm</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>Odometer</SHORT-NAME>
          <LENGTH>32</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/uint32</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/SysSignals/Odometer</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>SysSignals</SHORT-NAME>
      <ELEMENTS>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>EngineSpeed</SHORT-NAME>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/EngineSpeed_CM</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/EngineSpeed_DC</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
          <DESC>
            <L-2 L="EN">Engine speed &amp; direction</L-2>
          </DESC>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>CoolantTemp</SHORT-NAME>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/CoolantTemp_CM</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/CoolantTemp_DC</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>Gear</SHORT-NAME>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Gear_CM</COMPU-METHOD-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>Torque</SHORT-NAME>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Torque_CM</COMPU-METHOD-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>LampOn</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>LampCrc</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>LampCounter</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>Rpm</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>Odometer</SHORT-NAME>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/Odometer_CM</COMPU-METHOD-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>BaseTypes</SHORT-NAME>
      <ELEMENTS>
        <SW-BASE-TYPE>
          <SHORT-NAME>uint8</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <SW-BASE-TYPE>
          <SHORT-NAME>sint8</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>2C</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <SW-BASE-TYPE>
          <SHORT-NAME>uint16</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
        <SW-BASE-TYPE>
          <SHORT-NAME>uint32</SHORT-NAME>
          <CATEGORY>FIXED_LENGTH</CATEGORY>
          <BASE-TYPE-SIZE>32</BASE-TYPE-SIZE>
          <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
        </SW-BASE-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>Units</SHORT-NAME>
      <ELEMENTS>
        <UNIT>
          <SHORT-NAME>rpm</SHORT-NAME>
          <DISPLAY-NAME>rpm</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>degC</SHORT-NAME>
          <DISPLAY-NAME>°C</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>Nm</SHORT-NAME>
          <DISPLAY-NAME>Nm</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>km</SHORT-NAME>
          <DISPLAY-NAME>km</DISPLAY-NAME>
        </UNIT>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>CompuMethods</SHORT-NAME>
      <ELEMENTS>
        <COMPU-METHOD>
          <SHORT-NAME>EngineSpeed_CM</SHORT-NAME>
          <CATEGORY>LINEAR</CATEGORY>
          <UNIT-REF DEST="UNIT">/Units/rpm</UNIT-REF>
          <COMPU-INTERNAL-TO-PHYS>
            <COMPU-SCALES>
              <COMPU-SCALE>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">65535</UPPER-LIMIT>
                <COMPU-RATIONAL-COEFFS>
                  <COMPU-NUMERATOR>
                    <V>0</V>
                    <V>0.25</V>
                  </COMPU-NUMERATOR>
                  <COMPU-DENOMINATOR>
                    <V>1</V>
                  </COMPU-DENOMINATOR>
                </COMPU-RATIONAL-COEFFS>
              </COMPU-SCALE>
            </COMPU-SCALES>
          </COMPU-INTERNAL-TO-PHYS>
        </COMPU-METHOD>
        <COMPU-METHOD>
          <SHORT-NAME>CoolantTemp_CM</SHORT-NAME>
          <CATEGORY>LINEAR</CATEGORY>
          <UNIT-REF DEST="UNIT">/Units/degC</UNIT-REF>
          <COMPU-INTERNAL-TO-PHYS>
            <COMPU-SCALES>
              <COMPU-SCALE>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">-128</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">127</UPPER-LIMIT>
                <COMPU-RATIONAL-COEFFS>
                  <COMPU-NUMERATOR>
                    <V>-40</V>
                    <V>2</V>
                  </COMPU-NUMERATOR>
                  <COMPU-DENOMINATOR>
                    <V>2</V>
                  </COMPU-DENOMINATOR>
                </COMPU-RATIONAL-COEFFS>
              </COMPU-SCALE>
            </COMPU-SCALES>
          </COMPU-INTERNAL-TO-PHYS>
        </COMPU-METHOD>
        <COMPU-METHOD>
          <SHORT-NAME>Gear_CM</SHORT-NAME>
          <CATEGORY>TEXTTABLE</CATEGORY>
          <COMPU-INTERNAL-TO-PHYS>
            <COMPU-SCALES>
              <COMPU-SCALE>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0</UPPER-LIMIT>
                <COMPU-CONST>
                  <VT>Neutral</VT>
                </COMPU-CONST>
              </COMPU-SCALE>
              <COMPU-SCALE>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">1</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">1</UPPER-LIMIT>
                <COMPU-CONST>
                  <VT>First</VT>
                </COMPU-CONST>
              </COMPU-SCALE>
              <COMPU-SCALE>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">15</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">15</UPPER-LIMIT>
                <COMPU-CONST>
                  <VT>Reverse</VT>
                </COMPU-CONST>
              </COMPU-SCALE>
            </COMPU-SCALES>
          </COMPU-INTERNAL-TO-PHYS>
        </COMPU-METHOD>
        <COMPU-METHOD>
          <SHORT-NAME>Torque_CM</SHORT-NAME>
          <CATEGORY>LINEAR</CATEGORY>
          <UNIT-REF DEST="UNIT">/Units/Nm</UNIT-REF>
          <COMPU-INTERNAL-TO-PHYS>
            <COMPU-SCALES>
              <COMPU-SCALE>
                <COMPU-RATIONAL-COEFFS>
                  <COMPU-NUMERATOR>
                    <V>-500</V>
                    <V>0.5</V>
                  </COMPU-NUMERATOR>
                  <COMPU-DENOMINATOR>
                    <V>1</V>
                  </COMPU-DENOMINATOR>
                </COMPU-RATIONAL-COEFFS>
              </COMPU-SCALE>
            </COMPU-SCALES>
          </COMPU-INTERNAL-TO-PHYS>
        </COMPU-METHOD>
        <COMPU-METHOD>
          <SHORT-NAME>Odometer_CM</SHORT-NAME>
          <CATEGORY>LINEAR</CATEGORY>
          <UNIT-REF DEST="UNIT">/Units/km</UNIT-REF>
          <COMPU-INTERNAL-TO-PHYS>
            <COMPU-SCALES>
              <COMPU-SCALE>
                <COMPU-RATIONAL-COEFFS>
                  <COMPU-NUMERATOR>
                    <V>0</V>
                    <V>0.1</V>
                  </COMPU-NUMERATOR>
                  <COMPU-DENOMINATOR>
                    <V>1</V>
                  </COMPU-DENOMINATOR>
                </COMPU-RATIONAL-COEFFS>
              </COMPU-SCALE>
            </COMPU-SCALES>
          </COMPU-INTERNAL-TO-PHYS>
        </COMPU-METHOD>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>Constraints</SHORT-NAME>
      <ELEMENTS>
        <DATA-CONSTR>
          <SHORT-NAME>EngineSpeed_DC</SHORT-NAME>
          <DATA-CONSTR-RULES>
            <DATA-CONSTR-RULE>
              <PHYS-CONSTRS>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">8000</UPPER-LIMIT>
              </PHYS-CONSTRS>
            </DATA-CONSTR-RULE>
          </DATA-CONSTR-RULES>
        </DATA-CONSTR>
        <DATA-CONSTR>
          <SHORT-NAME>CoolantTemp_DC</SHORT-NAME>
          <DATA-CONSTR-RULES>
            <DATA-CONSTR-RULE>
              <INTERNAL-CONSTRS>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">-100</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">100</UPPER-LIMIT>
              </INTERNAL-CONSTRS>
            </DATA-CONSTR-RULE>
          </DATA-CONSTR-RULES>
        </DATA-CONSTR>
      </ELEMENTS>
    </AR-PACKAGE>

    <AR-PACKAGE>
      <SHORT-NAME>E2E</SHORT-NAME>
      <ELEMENTS>
        <END-TO-END-PROTECTION-SET>
          <SHORT-NAME>Protections</SHORT-NAME>
          <END-TO-END-PROTECTIONS>
            <END-TO-END-PROTECTION>
              <SHORT-NAME>LampFrame_E2E</SHORT-NAME>
              <END-TO-END-PROFILE>
                <CATEGORY>PROFILE_01</CATEGORY>
                <COUNTER-OFFSET>56</COUNTER-OFFSET>
                <CRC-OFFSET>48</CRC-OFFSET>
                <DATA-ID-MODE>ALL-16-BIT</DATA-ID-MODE>
                <DATA-IDS>
                  <DATA-ID>42</DATA-ID>
                </DATA-IDS>
                <DATA-LENGTH>64</DATA-LENGTH>
              </END-TO-END-PROFILE>
              <END-TO-END-PROTECTION-I-SIGNAL-I-PDUS>
                <END-TO-END-PROTECTION-I-SIGNAL-I-PDU>
                  <DATA-LENGTH>64</DATA-LENGTH>
                  <DATA-OFFSET>0</DATA-OFFSET>
                  <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/PDUs/LampFrame_PDU</I-SIGNAL-I-PDU-REF>
                </END-TO-END-PROTECTION-I-SIGNAL-I-PDU>
              </END-TO-END-PROTECTION-I-SIGNAL-I-PDUS>
            </END-TO-END-PROTECTION>
          </END-TO-END-PROTECTIONS>
        </END-TO-END-PROTECTION-SET>
