+    // Escape hatch: GUI_NO_PORTAL forces the zenity/kdialog fallback. The XDG
+    // portal's synchronous Response wait (portal_wait_response) blocks the UI
+    // thread and never receives the FileChooser Response under some environments
+    // (e.g. WSLg), wedging the app. Truthy GUI_NO_PORTAL avoids the portal path;
+    // "0"/""/unset keep the portal (so GUI_NO_PORTAL=0 re-enables it).
+    const char* no_portal = getenv("GUI_NO_PORTAL");
+    if (no_portal != NULL && no_portal[0] != '\0' && strcmp(no_portal, "0") != 0) {
+        portal_is_available = 0;
+        return 0;
+    }
