# V build artifacts
blobly_net
main
cmd/mf4_dump/mf4_dump
*.tmp.c
/src/main
/src/blobly_net
/build/

# Editor
*.swp

# Python tools venv (asammdf MF4 bridge) — dev-only, not committed
.venv-tools/
# Python DoIP oracle venv (scapy) — dev-only, not committed
.venv-doip/

# Private external DBCs copied in locally for simulation — NOT ours to commit.
dbc/ecu_vcm/
projects/ecu-vcm.yml

# MF4 recordings are private/binary — never commit one anywhere in the tree
# (the only exception is the tiny synthetic samples/demo.mf4, re-included below).
*.mf4
# Real MF4 sample recordings (binary, fetched by scripts/setup_mf4_tools.sh).
# Exclude the contents but not the dir itself, so the demo log below can be
# re-included (git can't un-ignore a file whose parent dir is excluded).
samples/*
# …but ship the tiny candump demo log + its MF4 twin so "Open Log" (and the
# MF4-aware open) work out of the box.
!samples/demo.log
!samples/demo.mf4

# Python bytecode cache
__pycache__/
*.pyc
heaptrack.*.gz
massif.out.*
imgui.ini
