#!/usr/bin/env -S v run

// gen.vsh writes assets.v from the PNGs beside it:  v run cmd/blobly_net/assets/gen.vsh
// Run it after changing a PNG; assets_test.v fails until you do. Why the bytes are spelled out
// rather than taken with $embed_file is in assets.v.
import os

const here = os.dir(@FILE)

const files = [
	['logo_png', 'logo_white.png'],
	['icon_png', 'icon_b.png'],
]

mut out := []string{}
out << 'module assets'
out << ''
out << '// GENERATED by gen.vsh from the PNGs in this directory — do not edit; assets_test.v pins it.'
out << '//'
out << '// The bytes are spelled out because V3 does not embed a `\$embed_file` outside -prod: it'
out << '// stores the BUILD machine\'s path, and `.data()` reads that file at run time and panics'
out << '// when it is not there — which on every machine but the one that built it, it is not.'
out << '// The shipped build is not -prod (#284), so the window icon took the Windows bundle down'
out << '// before its first frame (#455). `scripts/check_cmds.sh` refuses `\$embed_file` anywhere.'
for f in files {
	bytes := os.read_bytes(os.join_path(here, f[1]))!
	out << ''
	out << '// ${f[1]}, ${bytes.len} bytes'
	out << 'pub const ${f[0]} = [u8(${bytes[0]}),'
	mut line := []string{}
	for b in bytes[1..] {
		line << '${b}'
		if line.len == 24 {
			out << '\t' + line.join(', ') + ','
			line.clear()
		}
	}
	if line.len > 0 {
		out << '\t' + line.join(', ') + ','
	}
	out << ']'
}
os.write_file(os.join_path(here, 'assets.v'), out.join('\n') + '\n')!
println('wrote ${os.join_path(here, 'assets.v')}')
