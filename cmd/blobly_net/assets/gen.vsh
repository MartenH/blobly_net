#!/usr/bin/env -S v run

// gen.vsh writes assets.v from the PNGs beside it:  v run cmd/blobly_net/assets/gen.vsh
// Run it after adding or changing a PNG; assets_test.v fails until you do. Why the bytes are
// spelled out rather than taken with $embed_file is in assets.v.
import os

const here = os.dir(@FILE)

// const name -> file. ONE list: assets.v carries it as `files`, which the test walks.
const table = [
	['logo_png', 'logo_white.png'],
	['icon_png', 'icon_b.png'],
]

mut out := []string{}
out << 'module assets'
out << ''
out << '// GENERATED by gen.vsh from the PNGs in this directory — do not edit; assets_test.v pins it.'
out << '//'
out << '// The bytes are spelled out because V3 does not embed a `\$embed_file` outside -prod: it'
out << '// stores the BUILD machine\'s path, and `.data()` reads that file at run time and panics'
out << '// when it is not there — which on every machine but the one that built it, it is not.'
out << '// The shipped build is not -prod (#284), so the window icon took the Windows bundle down'
out << '// before its first frame (#455). `scripts/check_cmds.sh` refuses `\$embed_file` in'
out << '// cmd/, blobly/ and libs/.'
for t in table {
	bytes := os.read_bytes(os.join_path(here, t[1]))!
	if bytes.len == 0 {
		eprintln('${t[1]} is empty')
		exit(1)
	}
	out << ''
	out << '// ${t[1]}, ${bytes.len} bytes'
	out << 'pub const ${t[0]} = [u8(${bytes[0]}),'
	mut line := []string{}
	for b in bytes[1..] {
		line << '${b}'
		if line.len == 24 {
			out << '\t' + line.join(', ') + ','
			line.clear()
		}
	}
	if line.len > 0 {
		out << '\t' + line.join(', ') + ','
	}
	out << ']'
}
out << ''
out << '// files is every asset by its file name, for the test.'
out << 'pub const files = {'
for t in table {
	out << "\t'${t[1]}': ${t[0]}"
}
out << '}'
os.write_file(os.join_path(here, 'assets.v'), out.join('\n') + '\n')!
println('wrote ${os.join_path(here, 'assets.v')}')
