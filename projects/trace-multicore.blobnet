# Watch blobly_emb's trace_multicore capture in the Trace Chart swimlane.
#
# trace_multicore (blobly_emb/examples/trace_multicore) runs TWO simulated cores, each a
# Loom scheduler with its own ring buffer, and reads them out on command over ISO-TP. Open
# this project, Start the channel, then press "Dump" in the Trace Chart (≣): blobly_net
# freezes both cores and dumps them in one command (core_mask), reassembles each per-core
# ISO-TP block on 0x7E5 (flow control on 0x7E6), and draws the handler bars + thread-switch
# marks — a multi-core swimlane. handler_id resolves via the manifest below.
#
# Run:  (in blobly_emb/examples/trace_multicore:  make vcan && make run)
#       BLOBLY_PROJECT=projects/trace-multicore.blobnet ./scripts/run_vgui.sh
project:
  name: trace-multicore
  version: 1

channels:
  - name: CAN1
    type: can
    interface: vcan0
    mode: monitor
    manifest: manifests/trace-multicore.csv
