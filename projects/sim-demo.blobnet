# Native simulation demo — three networks, ECUs distributed across them.
#
# CAN1 (powertrain/chassis) and CAN2 (body/energy) are independent driver-free
# in-process buses. The tester monitors BOTH and simulates the ECUs configured on
# each. The Buses + Simulation panels show both networks; the trace's Ch column
# tells CAN1 frames from CAN2. Press ▶ Start and toggle nodes per network. Runs
# identically on Linux and Windows, no drivers.
#
# DoIP1 is diagnostics over Ethernet (ISO 13400) on the same vehicle: no frames,
# no bus — a logical-address endpoint on localhost TCP/UDP 13400. It serves the
# SAME identity as SUT on CAN1, which is the point of having it here: one ECU,
# two carriers, and a script that reads the VIN over either. See tests/mixed_carriers.lua.
#
# HEADLESS ONLY for now: the entity is brought up by scripts/runtests.sh, which
# binds port 13400 while it runs. Pressing Start in the GUI does NOT host it —
# DoIP1 stays idle and the Diagnostics panel cannot reach it (see docs/doip.md).
# The CAN buses are driver-free either way; the DoIP endpoint is a real socket.
project:
  name: Simulation demo — CAN1 + CAN2
  version: 1

channels:
  # --- CAN1: powertrain + chassis ---
  - name: CAN1
    type: can
    interface: inproc:CAN1
    mode: monitor
    databases:
      - dbc/blobly_net.dbc        # the network owns the database
    simulation:           # the simulation workload on this bus (was `nodes:`)
      - name: SUT
        signals:
          # type: const | sine | sawtooth | counter | stepmod
          - { name: EngineSpeed,  type: sine,    offset: 1600, amplitude: 1500, freq: 0.7, phase: 0 }
          - { name: VehicleSpeed, type: sine,    offset: 70,   amplitude: 60,   freq: 0.9, phase: 1 }
          - { name: CoolantTemp,  type: sine,    offset: 90,   amplitude: 15,   freq: 1.1, phase: 2 }
          - { name: ThrottlePos,  type: sine,    offset: 45,   amplitude: 45,   freq: 1.3, phase: 3 }
          - { name: Gear,         type: stepmod, period: 1,    count: 6,        base: 1 }
          - { name: CruiseOn,     type: stepmod, period: 2,    count: 2,        base: 0 }
          - { name: Counter,      type: counter, start: 0,     step: 1,         modulo: 256 }
        responses:
          - { request: "0x101", response: "0x102", byte: 0, add: 1 }
        # Diagnostics: this ECU answers on its OWN addresses with its own data, so a tester
        # can tell it from ChassisECU below. Configuring any per-ECU server replaces the
        # channel-wide 0x7E0/0x7E8 default — see docs/simulation.md.
        uds:
          rx: "0x7E0"
          tx: "0x7E8"
          dids:
            - { id: "0xF190", text: "BLOBLYNETV0SUT001" }
            - { id: "0xF18C", text: "SN-0001" }
            - { id: "0xF195", bytes: "01 00" }
          dtcs:
            - { code: "0x123456", status: 9 }
            - { code: "0xABCDEF", status: 8 }
      - name: ChassisECU
        uds:
          rx: "0x7E1"
          tx: "0x7E9"
          dids:
            - { id: "0xF190", text: "BLOBLY-CHASSIS-01" }
          dtcs:
            - { code: "0xC00101", status: 9 }
        signals:
          - { name: WheelFL, type: sine, offset: 60, amplitude: 8, freq: 0.9, phase: 0.0 }
          - { name: WheelFR, type: sine, offset: 60, amplitude: 8, freq: 0.9, phase: 0.1 }
          - { name: WheelRL, type: sine, offset: 60, amplitude: 8, freq: 0.9, phase: 0.2 }
          - { name: WheelRR, type: sine, offset: 60, amplitude: 8, freq: 0.9, phase: 0.3 }
          - { name: BrakePressure, type: sawtooth, min: 0, max: 1500, period: 6 }
          - { name: BrakePedal, type: sine, offset: 20, amplitude: 20, freq: 0.5 }
    # Interactive generators (conventional tooling IG-style): triggerable custom frames. Press
    # the button in the Generators panel, or the listed key (when no input is
    # focused). The SUT's response rule above answers 0x101 (Request) with 0x102,
    # so "Ping ECU" round-trips. Per-channel, so these send on CAN1.
    senders:
      - name: Ping ECU (Request)
        key: p
        message: Request
        trigger: key
        signals:
          - { name: ReqCode, value: 1 }
      - name: Rev to 6000 rpm
        key: r
        message: Powertrain
        trigger: key
        signals:
          - { name: EngineSpeed, value: 6000 }
          - { name: Gear, value: 4 }
      - name: Heartbeat pulse
        message: Heartbeat
        trigger: manual
      - name: Cyclic wake (0x123)
        id: "0x123"
        data: DE AD BE EF
        trigger: cyclic
        cycle_ms: 500

  # --- DoIP: the same SUT, reached over Ethernet instead of CAN ---
  # No `databases:` and no signals: a DoIP channel carries diagnostics, not frames.
  # rx/tx are deliberately absent — addressing here is the logical pair below, and
  # configuring CAN ids on a DoIP node is reported as ignored rather than obeyed.
  - name: DoIP1
    type: doip
    interface: doip:127.0.0.1:13400
    tester_address: "0x0E80"      # our (tester) logical address
    ecu_address: "0x1000"         # the entity's logical address
    simulation:
      - name: SUT
        uds:
          dids:
            - { id: "0xF190", text: "BLOBLYNETV0SUT001" }   # same VIN as SUT on CAN1
            - { id: "0xF18C", text: "SN-0001" }
            - { id: "0xF195", bytes: "01 00" }
          dtcs:
            - { code: "0x123456", status: 9 }
            - { code: "0xABCDEF", status: 8 }

  # --- CAN2: body + energy ---
  - name: CAN2
    type: can
    interface: inproc:CAN2
    mode: monitor
    databases:
      - dbc/blobly_net.dbc
    simulation:           # the simulation workload on this bus (was `nodes:`)
      - name: BodyECU
        signals:
          - { name: InteriorTemp, type: sine, offset: 22, amplitude: 3, freq: 0.05 }
          - { name: Headlights, type: stepmod, period: 5, count: 4, base: 0 }
          - { name: Indicators, type: stepmod, period: 3, count: 4, base: 0 }
          - { name: Locked, type: const, value: 1 }
          - { name: DoorFL, type: stepmod, period: 7, count: 2, base: 0 }
      - name: BatteryECU
        signals:
          - { name: PackVoltage, type: sine, offset: 400, amplitude: 5, freq: 0.2 }
          - { name: PackCurrent, type: sine, offset: 0, amplitude: 50, freq: 0.3 }
          - { name: SoC, type: sawtooth, min: 100, max: 20, period: 30 }
          - { name: PackTemp, type: sine, offset: 30, amplitude: 5, freq: 0.1 }
