# Blobly Net project — simulated nodes announcing network management, zero drivers, no hardware.
#
# The cluster is read from system.toml beside this file (the channel is named after its bus,
# `body`): sysnode and domain are simulated, and each announces its NM PDU — NID and a control
# bit vector of 0x00 — on the id the system model gives it (0x511, 0x513) every 100 ms, the
# cycle blobly_emb gives a cluster whose msg_cycle_ms is not stated. zone_a is declared and not simulated: missing.
#
#   BLOBLY_PROJECT=projects/nm-demo/nm-sim.blobnet ./scripts/run_gui.sh
#   → ▶ Start, then View ▸ Network Management
#
# tests/nm_sim.lua and python/tests/test_nm_sim.py release the network for the simulated nodes,
# watch the cluster sleep, and request it again.
project:
  name: nm-sim
  version: 12

channels:
  - name: body
    type: can
    interface: inproc:NMSIM   # driver-free in-process bus
    bitrate: 500000
    enabled: true
    databases:
      - nm-demo.dbc
    simulate:
      - sysnode
      - domain
