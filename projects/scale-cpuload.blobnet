# Blobly Net project — watch blobly_emb's self-reported per-core CPU load.
#
# The blobly_emb `scale` example transmits a CpuLoad frame (id 0x7E0) on vcan0
# every 500 ms — one byte per core = load percent (the Loom measures its own
# handler duty cycle; see blobly_emb/docs/telemetry.md). This project monitors
# vcan0 and decodes it via dbc/cpuload.dbc, so the Signals/Trace panels show
# Load_Core0..7 live (the DBC defines eight cores; a producer may populate fewer).
#
# Run it:
#   # in blobly_emb:
#   sudo make vcan && (cd examples/scale && make all) && scripts/scale-bench.sh &
#   # here:
#   BLOBLY_PROJECT=projects/scale-cpuload.yml ./scripts/run.sh   # → Start
project:
  name: scale-cpuload
  version: 1

channels:
  - name: CAN1
    type: can            # classic CAN; CpuLoad is an 8-byte standard frame
    interface: vcan0     # the bus blobly_emb scale sends CpuLoad on (can0)
    bitrate: 500000      # nominal (vcan ignores it)
    mode: monitor        # observe the load frames
    listen_only: true    # nothing in blobly_net transmits on this wire: Send, generators,
                         # simulated ECUs, replay and scripts all get a bus that refuses.
                         # The transceiver is silenced too on Vector only (`,silent`);
                         # elsewhere it still ACKs, and on SocketCAN that needs
                         # `ip link set canX type can listen-only`.
    enabled: true
    databases:
      - dbc/cpuload.dbc
