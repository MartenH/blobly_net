# Blobly Net project — driver-free virtual bench over the UDP software bus.
#
# Cross-platform alternative to projects/demo.yml: instead of Linux `vcan0`, the
# channel uses the `udp:` software bus (transport/udpbus.v), so the whole
# virtual-first flow runs with NO kernel vcan and NO drivers — on Windows too.
#
# Run it:
#   python3 sut/can_sut.py udp                       # the virtual ECU
#   BLOBLY_PROJECT=projects/demo-udp.yml ./scripts/run.sh   # the tester → Start
project:
  name: virtual-bench-udp
  version: 1

channels:
  - name: CAN1
    type: can
    interface: udp:239.63.42.1:20000   # udp[:group[:port]] → software bus
    mode: normal
    enabled: true
    databases:
      - dbc/blobly_net.dbc
