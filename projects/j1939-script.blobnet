# Blobly Net project — J1939 from a script (#507), zero drivers, no hardware.
#
# Three rows on ONE in-process wire, so a script plays every node itself: nothing here
# simulates J1939 (the engine reads it, it answers nothing).
#
#   J1939  the listener: its database declares J1939 (VFrameFormat J1939PG), so every row on
#          its wire rejoins transport-protocol messages from its handle's first read
#   Peer   a node the script sends as (SA 0x21: a BAM, an RTS, address claims)
#   Other  the other end of a connection (SA 0x00: the CTS and the acknowledgement)
#
# and two on a second wire nothing declares J1939, which reads it only when the script asks:
#
#   Plain, PlainPeer
#
# and a third wire whose only declaration is a DISABLED alias's tick, which still counts (the
# wire reads as J1939, as in the GUI's census) while the disabled row stays out of the run:
#
#   Alias, AliasPeer, AliasOff (disabled, j1939: true)
#
#   ./scripts/runtests.sh tests/j1939.lua
#   python3 python/examples/j1939_listen.py
project:
  name: j1939-script
  # v6: a channel's `j1939:` tick
  version: 6

channels:
  - name: J1939
    type: can
    interface: inproc:J1939S
    bitrate: 250000
    databases:
      - ../dbc/j1939_demo.dbc
  - name: Peer
    type: can
    interface: inproc:J1939S
    bitrate: 250000
  - name: Other
    type: can
    interface: inproc:J1939S
    bitrate: 250000
  - name: Plain
    type: can
    interface: inproc:J1939P
    bitrate: 250000
  - name: PlainPeer
    type: can
    interface: inproc:J1939P
    bitrate: 250000
  - name: Alias
    type: can
    interface: inproc:J1939A
    bitrate: 250000
  - name: AliasPeer
    type: can
    interface: inproc:J1939A
    bitrate: 250000
  - name: AliasOff
    type: can
    interface: inproc:J1939A
    bitrate: 250000
    enabled: false
    j1939: true
