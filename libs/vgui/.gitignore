# fetched deps + built artifacts (regenerated by build_deps.sh)
build/
libvgui_c.a
*.o
# imgui writes window-layout state to the CWD at runtime
imgui.ini
# compiled example binaries (V output) — NOT the source dir. The old pattern
# `examples/**/trace_chart` also matched the examples/trace_chart/ dir itself, so
# `git add` silently skipped the source; scope to the binary file names only.
examples/*/trace_chart
examples/*/trace_chart.exe
examples/**/*.ppm
examples/*/live_trace
examples/*/live_trace.exe
